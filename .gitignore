# Ambiente virtual Python
venv/
env/
.venv/

# Base de dados local
db.sqlite3

# Ficheiros de configuração sensíveis
.env

# Ficheiros de CV submetidos pelos candidatos
media/resumes/

# Logs da aplicação (gerados em runtime — ver LOGGING em core/settings.py)
logs/*.log
!logs/.gitkeep

# Estáticos gerados por `collectstatic` (ver STORAGES/WhiteNoise em core/settings.py)
staticfiles/*
!staticfiles/.gitkeep

# Ficheiros Python compilados
__pycache__/
*.pyc
*.pyo
*.pyd

# Ficheiros do sistema operativo
.DS_Store
Thumbs.db

# Ficheiros do editor de código
.vscode/
.idea/
*.swp