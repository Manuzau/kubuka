# ============================================================
# KUBUKA - configuracao do ambiente
# Copiar este ficheiro para .env e preencher os valores reais
# ============================================================

# --- Django ---
# OBRIGATORIO em producao - gera com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cola-aqui-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de dados PostgreSQL ---
DB_NAME=kubuka_db
DB_USER=kubuka_user
DB_PASSWORD=kubuka_pass
DB_HOST=localhost
DB_PORT=5432

# --- n8n (URLs dos webhooks) ---
# IMPORTANTE (Windows): usar 127.0.0.1 em vez de localhost para evitar falhas
# de resolucao IPv6 (o Node.js resolve localhost como ::1 mas o Django ouve em IPv4).
N8N_WEBHOOK_CV_URL=http://127.0.0.1:5678/webhook/cv-analysis
N8N_WEBHOOK_SCORE_URL=http://127.0.0.1:5678/webhook/job-scoring

# Token partilhado entre Django e n8n. Sem este valor, os callbacks sao bloqueados.
# Gera com: python -c "import secrets; print(secrets.token_hex(32))"
N8N_CALLBACK_SECRET=kubuka-secret-token-2025

# URL base do Django, usado nos callbacks do n8n (usar 127.0.0.1 no Windows)
DJANGO_BASE_URL=http://127.0.0.1:8000

# --- Email ---
# Em desenvolvimento fica na consola; em producao apagar esta linha e configurar SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=teu-email@gmail.com
EMAIL_HOST_PASSWORD=app-password-aqui
DEFAULT_FROM_EMAIL=KUBUKA <noreply@kubuka.ao>

# ============================================================
# Checklist de producao - activar antes do deploy
# ============================================================
# DEBUG=False
# ALLOWED_HOSTS=meudominio.ao,www.meudominio.ao
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
